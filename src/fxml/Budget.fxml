<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="10" alignment="CENTER" xmlns:fx="http://javafx.com/fxml" fx:controller="controllers.BudgetController">
    <Label text="Set Monthly Budget" style="-fx-font-size: 18px;"/>
    
    <HBox spacing="10">
        <Label text="Category:"/>
        <ComboBox fx:id="categoryComboBox" promptText="Select Category"/>
    </HBox>
    
    <HBox spacing="10">
        <Label text="Limit Amount:"/>
        <TextField fx:id="limitField" promptText="e.g., 5000"/>
    </HBox>

    <Button text="Save Budget" onAction="#handleSaveBudget"/>
    <Label fx:id="messageLabel"/>

    <TableView fx:id="budgetTable" prefWidth="300">
        <columns>
            <TableColumn fx:id="categoryColumn" text="Category" />
            <TableColumn fx:id="limitColumn" text="Limit" />
        </columns>
    </TableView>
</VBox>
