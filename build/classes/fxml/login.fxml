<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.*?>

<VBox xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="controllers.AuthController" alignment="CENTER" spacing="10">

    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <Label text="Personal Finance Login" style="-fx-font-size: 24px; -fx-font-weight: bold;" />

    <TextField fx:id="usernameField" promptText="Username" maxWidth="250" />

    <PasswordField fx:id="passwordField" promptText="Password" maxWidth="250" />

    <Button text="Login" onAction="#handleLogin" maxWidth="100" />

    <HBox spacing="5" alignment="CENTER">
        <Label text="Don't have an account?" />
        <Button text="Sign Up" onAction="#openSignup" />
    </HBox>

</VBox>
