<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controllers.DashboardController">

    <top>
        <HBox spacing="10" BorderPane.alignment="CENTER">
            <padding>
                <Insets top="10" right="10" bottom="10" left="10"/>
            </padding>
            <Label fx:id="welcomeLabel" text="Welcome, User!" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="Add Transaction" onAction="#handleAddTransaction"/>
            <Button text="Edit Selected" onAction="#handleEditTransaction"/>
            <Button text="Delete Selected" onAction="#handleDeleteTransaction"/>
        </HBox>
    </top>

    <center>
        <TableView fx:id="transactionTable" prefHeight="400" prefWidth="700" BorderPane.alignment="CENTER">
            <columns>
                <TableColumn fx:id="colDescription" text="Description" prefWidth="150"/>
                <TableColumn fx:id="colCategory" text="Category" prefWidth="120"/>
                <TableColumn fx:id="colAmount" text="Amount" prefWidth="90"/>
                <TableColumn fx:id="colType" text="Type" prefWidth="90"/>
                <TableColumn fx:id="colDate" text="Date" prefWidth="120"/>
                <TableColumn fx:id="colNote" text="Note" prefWidth="130"/>
            </columns>
        </TableView>
    </center>

    <bottom>
        <HBox spacing="20" BorderPane.alignment="CENTER">
            <padding>
                <Insets top="10" right="10" bottom="10" left="10"/>
            </padding>
            <Label text="Total Income:"/>
            <Label fx:id="totalIncomeLabel" text="0.00" style="-fx-font-weight: bold;"/>
            <Label text="Total Expense:"/>
            <Label fx:id="totalExpenseLabel" text="0.00" style="-fx-font-weight: bold;"/>
            <Label text="Remaining Budget:"/>
            <Label fx:id="remainingBudgetLabel" text="0.00" style="-fx-font-weight: bold;"/>
        </HBox>
    </bottom>

</BorderPane>
