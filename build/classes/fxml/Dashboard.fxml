<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="controllers.DashboardController"
      spacing="20" alignment="TOP_CENTER" style="-fx-background-color: #f9f9f9;" prefWidth="800" prefHeight="600">

    <padding>
        <Insets top="20" right="30" bottom="20" left="30"/>
    </padding>

    <Label fx:id="welcomeLabel" text="Welcome!" style="-fx-font-size: 24px; -fx-text-fill: #0078D7; -fx-font-weight: bold;" />

    <TableView fx:id="transactionTable" prefHeight="400" prefWidth="740">
        <columns>
            <TableColumn fx:id="descriptionColumn" text="Description" prefWidth="300"/>
            <TableColumn fx:id="categoryColumn" text="Category" prefWidth="200"/>
            <TableColumn fx:id="amountColumn" text="Amount" prefWidth="200"/>
        </columns>
    </TableView>

    <HBox spacing="15" alignment="CENTER_RIGHT">
        <Button text="Add Transaction"
                style="-fx-background-color: #28a745; -fx-text-fill: white; -fx-font-weight: bold;"
                onAction="#openAddTransaction"/>
                
        <Button text="Go to Budget"
                style="-fx-background-color: #17a2b8; -fx-text-fill: white; -fx-font-weight: bold;"
                onAction="#openBudgetPage"/>

        <Button text="Logout"
                style="-fx-background-color: #dc3545; -fx-text-fill: white; -fx-font-weight: bold;"
                onAction="#handleLogout"/>
    </HBox>

</VBox>
