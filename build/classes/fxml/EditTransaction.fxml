<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.*?>

<AnchorPane xmlns:fx="http://javafx.com/fxml" fx:controller="controllers.EditTransactionController"
            prefWidth="400" prefHeight="480" style="-fx-background-color: #f8f4f0;">

    <children>
        <Label layoutX="30" layoutY="25" text="Edit Transaction"
               style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #333333;" />

        <Label layoutX="30" layoutY="70" text="Title:"
               style="-fx-font-size: 14px; -fx-text-fill: #444444;" />
        <TextField fx:id="titleField" layoutX="130" layoutY="65" prefWidth="220"
                   style="-fx-background-radius: 6; -fx-border-color: #dcdde1; -fx-padding: 8; -fx-font-size: 14px; -fx-text-fill: #333333;" />

        <Label layoutX="30" layoutY="110" text="Category:"
               style="-fx-font-size: 14px; -fx-text-fill: #444444;" />
        <ComboBox fx:id="categoryComboBox" layoutX="130" layoutY="105" prefWidth="220"
                  style="-fx-background-radius: 6; -fx-font-size: 14px; -fx-text-fill: #333333;" />

        <Label layoutX="30" layoutY="150" text="Amount:"
               style="-fx-font-size: 14px; -fx-text-fill: #444444;" />
        <TextField fx:id="amountField" layoutX="130" layoutY="145" prefWidth="220"
                   style="-fx-background-radius: 6; -fx-padding: 8; -fx-font-size: 14px; -fx-text-fill: #333333;" />

        <Label layoutX="30" layoutY="190" text="Type:"
               style="-fx-font-size: 14px; -fx-text-fill: #444444;" />
        <ComboBox fx:id="typeComboBox" layoutX="130" layoutY="185" prefWidth="220"
                  style="-fx-background-radius: 6; -fx-font-size: 14px; -fx-text-fill: #333333;" />

        <Label layoutX="30" layoutY="230" text="Date:"
               style="-fx-font-size: 14px; -fx-text-fill: #444444;" />
        <DatePicker fx:id="datePicker" layoutX="130" layoutY="225" prefWidth="220"
                    style="-fx-background-radius: 6; -fx-font-size: 14px; -fx-text-fill: #333333;" />

        <Label layoutX="30" layoutY="270" text="Note:"
               style="-fx-font-size: 14px; -fx-text-fill: #444444;" />
        <TextArea fx:id="noteArea" layoutX="130" layoutY="265" prefWidth="220" prefHeight="70"
                  style="-fx-background-radius: 6; -fx-font-size: 14px; -fx-text-fill: #333333; -fx-padding: 6;" />

        <Button layoutX="150" layoutY="360" text="Update"
                onAction="#handleUpdate" prefWidth="100"
                style="-fx-background-color: #b89b82; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6;" />
    </children>
</AnchorPane>
