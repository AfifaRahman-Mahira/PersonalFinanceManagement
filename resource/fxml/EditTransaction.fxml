<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.*?>

<AnchorPane xmlns:fx="http://javafx.com/fxml" fx:controller="controllers.EditTransactionController" prefWidth="350" prefHeight="400">
    <children>
        <Label layoutX="30" layoutY="20" text="Edit Transaction" style="-fx-font-size: 18px;" />

        <Label layoutX="30" layoutY="60" text="Title:" />
        <TextField fx:id="titleField" layoutX="100" layoutY="60" prefWidth="200"/>

        <Label layoutX="30" layoutY="100" text="Category:" />
        <ComboBox fx:id="categoryComboBox" layoutX="100" layoutY="100" prefWidth="200" />

        <Label layoutX="30" layoutY="140" text="Amount:" />
        <TextField fx:id="amountField" layoutX="100" layoutY="140" prefWidth="200"/>

        <Label layoutX="30" layoutY="180" text="Type:" />
        <ComboBox fx:id="typeComboBox" layoutX="100" layoutY="180" prefWidth="200" />

        <Label layoutX="30" layoutY="220" text="Date:" />
        <DatePicker fx:id="datePicker" layoutX="100" layoutY="220" prefWidth="200" />

        <Label layoutX="30" layoutY="260" text="Note:" />
        <TextArea fx:id="noteArea" layoutX="100" layoutY="260" prefWidth="200" prefHeight="60" />

        <Button layoutX="100" layoutY="340" text="Update" onAction="#handleUpdate" prefWidth="100"/>
    </children>
</AnchorPane>
