<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.*?>

<VBox xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="controllers.SignupController" alignment="CENTER" spacing="10">

    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <Label text="Sign Up" style="-fx-font-size: 24px; -fx-font-weight: bold;" />

    <TextField fx:id="fullNameField" promptText="Full Name" maxWidth="250" />
    <TextField fx:id="usernameField" promptText="Username" maxWidth="250" />
    <PasswordField fx:id="passwordField" promptText="Password" maxWidth="250" />
    <TextField fx:id="emailField" promptText="Email" maxWidth="250" />

    <HBox spacing="10" alignment="CENTER_LEFT">
        <Label text="Gender:" />
        <RadioButton fx:id="maleRadio" text="Male" toggleGroup="$genderGroup" />
        <RadioButton fx:id="femaleRadio" text="Female" toggleGroup="$genderGroup" />
    </HBox>

    <Button text="Register" onAction="#handleSignup" maxWidth="150" />

    <HBox spacing="5" alignment="CENTER">
        <Label text="Already have an account?" />
        <Button text="Login" onAction="#openLogin" />
    </HBox>

</VBox>
