<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<GridPane xmlns:fx="http://javafx.com/fxml"
          fx:controller="controllers.SetBudgetController"
          hgap="10" vgap="10">
    
    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <Label text="Set Monthly Budget" GridPane.columnSpan="2" style="-fx-font-size: 16px; -fx-font-weight: bold;" />

    <Label text="Total Budget:" GridPane.rowIndex="1" GridPane.columnIndex="0" />
    <TextField fx:id="totalField" GridPane.rowIndex="1" GridPane.columnIndex="1" />

    <Label text="Food:" GridPane.rowIndex="2" GridPane.columnIndex="0" />
    <TextField fx:id="foodField" GridPane.rowIndex="2" GridPane.columnIndex="1" />

    <Label text="Transport:" GridPane.rowIndex="3" GridPane.columnIndex="0" />
    <TextField fx:id="transportField" GridPane.rowIndex="3" GridPane.columnIndex="1" />

    <Label text="Shopping:" GridPane.rowIndex="4" GridPane.columnIndex="0" />
    <TextField fx:id="shoppingField" GridPane.rowIndex="4" GridPane.columnIndex="1" />

    <Label text="Other:" GridPane.rowIndex="5" GridPane.columnIndex="0" />
    <TextField fx:id="otherField" GridPane.rowIndex="5" GridPane.columnIndex="1" />
<Label fx:id="otherBudgetLabel" GridPane.rowIndex="18" GridPane.columnIndex="1"/>

    <Button text="Save Budget"
            onAction="#handleSaveBudget"
            GridPane.rowIndex="6" GridPane.columnSpan="2"
            style="-fx-background-color: #2196F3; -fx-text-fill: white;" />

    <!-- Spent and Remaining Labels -->
    <Label text="Spent / Remaining" GridPane.rowIndex="7" GridPane.columnSpan="2" style="-fx-font-weight: bold;" />

    <Label text="Total Spent:" GridPane.rowIndex="8" GridPane.columnIndex="0"/>
    <Label fx:id="totalSpentLabel" GridPane.rowIndex="8" GridPane.columnIndex="1"/>
    <Label text="Total Remaining:" GridPane.rowIndex="9" GridPane.columnIndex="0"/>
    <Label fx:id="totalRemainingLabel" GridPane.rowIndex="9" GridPane.columnIndex="1"/>

    <Label text="Food Spent:" GridPane.rowIndex="10" GridPane.columnIndex="0"/>
    <Label fx:id="foodSpentLabel" GridPane.rowIndex="10" GridPane.columnIndex="1"/>
    <Label text="Food Remaining:" GridPane.rowIndex="11" GridPane.columnIndex="0"/>
    <Label fx:id="foodRemainingLabel" GridPane.rowIndex="11" GridPane.columnIndex="1"/>

    <Label text="Transport Spent:" GridPane.rowIndex="12" GridPane.columnIndex="0"/>
    <Label fx:id="transportSpentLabel" GridPane.rowIndex="12" GridPane.columnIndex="1"/>
    <Label text="Transport Remaining:" GridPane.rowIndex="13" GridPane.columnIndex="0"/>
    <Label fx:id="transportRemainingLabel" GridPane.rowIndex="13" GridPane.columnIndex="1"/>

    <Label text="Shopping Spent:" GridPane.rowIndex="14" GridPane.columnIndex="0"/>
    <Label fx:id="shoppingSpentLabel" GridPane.rowIndex="14" GridPane.columnIndex="1"/>
    <Label text="Shopping Remaining:" GridPane.rowIndex="15" GridPane.columnIndex="0"/>
    <Label fx:id="shoppingRemainingLabel" GridPane.rowIndex="15" GridPane.columnIndex="1"/>

    <Label text="Other Spent:" GridPane.rowIndex="16" GridPane.columnIndex="0"/>
    <Label fx:id="otherSpentLabel" GridPane.rowIndex="16" GridPane.columnIndex="1"/>
    <Label text="Other Remaining:" GridPane.rowIndex="17" GridPane.columnIndex="0"/>
    <Label fx:id="otherRemainingLabel" GridPane.rowIndex="17" GridPane.columnIndex="1"/>

</GridPane>
