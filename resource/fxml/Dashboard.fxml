<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="controllers.DashboardController"
      spacing="10">

    <padding>
        <Insets top="10" right="10" bottom="10" left="10"/>
    </padding>

    <!-- Welcome Text -->
    <Label fx:id="welcomeLabel" text="Welcome, User!" style="-fx-font-size: 18px; -fx-font-weight: bold;" />

    <!-- Budget Summary -->
    <HBox spacing="20" alignment="CENTER_LEFT">

        <VBox spacing="5" style="-fx-border-color: gray; -fx-padding: 10;">
            <Label text="Total Budget:"/>
            <Label fx:id="totalBudgetLabel" text="৳ 0.00"/>
            <Label text="Remaining:"/>
            <Label fx:id="totalRemainingLabel" text="৳ 0.00"/>
        </VBox>

        <VBox spacing="5" style="-fx-border-color: gray; -fx-padding: 10;">
            <Label text="Food Budget:"/>
            <Label fx:id="foodBudgetLabel" text="৳ 0.00"/>
            <Label text="Remaining:"/>
            <Label fx:id="foodRemainingLabel" text="৳ 0.00"/>
        </VBox>

        <VBox spacing="5" style="-fx-border-color: gray; -fx-padding: 10;">
            <Label text="Transport Budget:"/>
            <Label fx:id="transportBudgetLabel" text="৳ 0.00"/>
            <Label text="Remaining:"/>
            <Label fx:id="transportRemainingLabel" text="৳ 0.00"/>
        </VBox>

        <VBox spacing="5" style="-fx-border-color: gray; -fx-padding: 10;">
            <Label text="Shopping Budget:"/>
            <Label fx:id="shoppingBudgetLabel" text="৳ 0.00"/>
            <Label text="Remaining:"/>
            <Label fx:id="shoppingRemainingLabel" text="৳ 0.00"/>
        </VBox>

        <VBox spacing="5" style="-fx-border-color: gray; -fx-padding: 10;">
            <Label text="Other Budget:"/>
            <Label fx:id="otherBudgetLabel" text="৳ 0.00"/>
            <Label text="Remaining:"/>
            <Label fx:id="otherRemainingLabel" text="৳ 0.00"/>
        </VBox>

    </HBox>

    <!-- Transaction Table -->
    <TableView fx:id="transactionTable" prefHeight="300" prefWidth="600">
        <columns>
            <TableColumn fx:id="colDescription" text="Description" prefWidth="150"/>
            <TableColumn fx:id="colCategory" text="Category" prefWidth="100"/>
            <TableColumn fx:id="colAmount" text="Amount" prefWidth="100"/>
            <TableColumn fx:id="colType" text="Type" prefWidth="100"/>
            <TableColumn fx:id="colDate" text="Date" prefWidth="100"/>
            <TableColumn fx:id="colNote" text="Note" prefWidth="150"/>
        </columns>
    </TableView>

    <!-- Summary of Income/Expense -->
    <HBox spacing="20">
        <padding>
            <Insets top="10" right="10" bottom="10" left="10"/>
        </padding>

        <VBox spacing="5">
            <Label text="Total Income:"/>
            <Label fx:id="totalIncomeLabel" text="0.00"/>
        </VBox>

        <VBox spacing="5">
            <Label text="Total Expense:"/>
            <Label fx:id="totalExpenseLabel" text="0.00"/>
        </VBox>

        <VBox spacing="5">
            <Label text="Remaining Balance:"/>
            <Label fx:id="remainingBalanceLabel" text="0.00"/>
        </VBox>
    </HBox>

    <!-- Currency Converter -->
    <HBox spacing="10" alignment="CENTER_LEFT">
        <TextField fx:id="amountField" promptText="Amount" prefWidth="100"/>
        <ComboBox fx:id="fromCurrencyCombo" prefWidth="80"/>
        <ComboBox fx:id="toCurrencyCombo" prefWidth="80"/>
        <Button text="Convert" onAction="#handleCurrencyConvert"/>
        <Label fx:id="convertedResultLabel" text=""/>
    </HBox>

    <!-- Buttons -->
    <HBox spacing="15" alignment="CENTER_RIGHT">
        <padding>
            <Insets top="10" right="10" bottom="10" left="10"/>
        </padding>

        <Button text="Add Transaction" onAction="#handleAddTransaction"/>
        <Button text="Edit Transaction" onAction="#handleEditTransaction"/>
        <Button text="Delete Transaction" onAction="#handleDeleteTransaction"/>
        <Button text="Set Budget" onAction="#handleOpenSetBudget"/>
    </HBox>

</VBox>
