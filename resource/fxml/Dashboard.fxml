<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.*?>

<BorderPane xmlns="http://javafx.com/javafx/8.0.171" 
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controllers.DashboardController"
            prefWidth="800" prefHeight="600">

    <top>
        <HBox spacing="10" alignment="CENTER_RIGHT">
            <padding>
                <Insets top="10" right="10" bottom="10" left="10"/>
            </padding>
            <Label fx:id="welcomeLabel" text="Welcome, User!" style="-fx-font-size: 16px; -fx-font-weight: bold;"/>
            <Button text="Add Transaction" onAction="#handleAddTransaction"/>
            <Button text="Set Budget" onAction="#handleSetBudget"/>
            <Button text="Logout" onAction="#handleLogout"/>
        </HBox>
    </top>

    <center>
        <VBox spacing="15" alignment="TOP_CENTER">
            <padding>
                <Insets top="20" right="20" bottom="20" left="20"/>
            </padding>

            <Label text="Your Transactions" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

            <TableView fx:id="transactionTable" prefHeight="400" prefWidth="750">
                <columns>
                    <TableColumn fx:id="colDescription" text="Description" prefWidth="150"/>
                    <TableColumn fx:id="colCategory" text="Category" prefWidth="120"/>
                    <TableColumn fx:id="colAmount" text="Amount" prefWidth="100"/>
                    <TableColumn fx:id="colType" text="Type" prefWidth="100"/>
                    <TableColumn fx:id="colDate" text="Date" prefWidth="120"/>
                    <TableColumn fx:id="colNote" text="Note" prefWidth="160"/>
                </columns>
            </TableView>

            <HBox spacing="30" alignment="CENTER">
                <Label text="Total Income:"/>
                <Label fx:id="totalIncomeLabel" text="0.00" style="-fx-font-weight: bold;"/>
                <Label text="Total Expense:"/>
                <Label fx:id="totalExpenseLabel" text="0.00" style="-fx-font-weight: bold;"/>
                <Label text="Remaining Budget:"/>
                <Label fx:id="remainingBudgetLabel" text="0.00" style="-fx-font-weight: bold;"/>
            </HBox>
        </VBox>
    </center>
    
</BorderPane>  <!-- এটা না থাকলে ফাইল এ্রর দেয় -->
