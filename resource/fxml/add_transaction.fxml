<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<AnchorPane xmlns:fx="http://javafx.com/fxml" fx:controller="controllers.AddTransactionController" prefWidth="400" prefHeight="450">
    <children>
        <VBox spacing="10" AnchorPane.topAnchor="10" AnchorPane.leftAnchor="10" AnchorPane.rightAnchor="10" AnchorPane.bottomAnchor="10">
            <padding>
                <Insets top="15" right="15" bottom="15" left="15"/>
            </padding>

            <Label text="Add New Transaction" style="-fx-font-size: 18px; -fx-font-weight: bold;" />

            <Label text="Title:" />
            <TextField fx:id="titleField" promptText="Enter title" />

            <Label text="Category:" />
            <TextField fx:id="categoryField" promptText="Enter category" />

            <Label text="Amount:" />
            <TextField fx:id="amountField" promptText="Enter amount" />

            <Label text="Type:" />
            <ComboBox fx:id="typeComboBox" promptText="Select type" />

            <Label text="Date:" />
            <DatePicker fx:id="datePicker" promptText="yyyy-MM-dd" />

            <Label text="Note:" />
            <TextArea fx:id="noteField" promptText="Additional notes" prefRowCount="3" wrapText="true" />

            <HBox spacing="15" alignment="CENTER_RIGHT">
                <Button text="Save" onAction="#handleSave" />
                <Button text="Cancel" onAction="#handleCancel" />
            </HBox>
        </VBox>
    </children>
</AnchorPane>
